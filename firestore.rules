rules_version = '2';

// Copia de referencia de las reglas publicadas en la consola de Firebase
// (Firestore → Reglas). Este archivo no se publica solo: si se cambia aquí,
// hay que pegarlo y publicarlo en la consola.
// 2026-09-27: roles dueño y mayordomo.
// 2026-11-19: lector de solo lectura (Alfonsito, agente de la finca, D-036/D-044).
//   El dueño pone el uid del lector en fincas/{id}.lectorUid. El lector lee todo
//   lo de esa finca y no escribe nada.
// 2026-11-22: lote cogido por día (Alfonsito F4, D-104), en fincas/{id}/lotesCogida/{lunes}.
//   Alfonsito escribe SOLO ahí, y solo si el dueño puso su uid en fincas/{id}.escritorUid
//   (esa es la aprobación separada de escritura). Un día por escritura, de lunes a viernes,
//   en una semana que ya exista, con campos fijos y sin tocar lo que corrigió una persona.
//   Las personas (dueño y mayordomo) escriben con la marca editadoPorPersona.

service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Quien hace la petición es el lector de solo lectura de esta finca?
    function esLector(fincaId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.get('lectorUid', '');
    }

    // ¿Quien hace la petición es el escritor autorizado de esta finca (Alfonsito con escritura)?
    function esEscritor(fincaId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.get('escritorUid', '');
    }

    function esMayordomo(fincaId) {
      return request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.get('mayordomoUid', '');
    }

    // Días en que se coge café (D-104: no se coge sábado ni domingo).
    function diasCogida() {
      return ['lun', 'mar', 'mie', 'jue', 'vie'];
    }

    // Días que cambia esta escritura frente a lo que hay guardado.
    function diasQueCambian() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
    }

    // Exactamente un día de lunes a viernes, y ese día sigue en el documento (no se borra).
    function cambiaUnSoloDia() {
      return diasQueCambian().size() == 1 && diasQueCambian().hasOnly(diasCogida());
    }

    function elDia() {
      return diasQueCambian().toList()[0];
    }

    // Entrada que escribe Alfonsito: campos fijos, origen "alfonsito", sin marca de persona.
    function entradaAlfonsito(e) {
      return e is map &&
        e.keys().hasAll(['loteId', 'loteNombre', 'origen', 'mensajeId', 'creadoEn', 'huella']) &&
        e.keys().hasOnly(['loteId', 'loteNombre', 'origen', 'mensajeId', 'creadoEn', 'huella']) &&
        e.origen == 'alfonsito' &&
        e.loteId is string && e.loteId.size() > 0 && e.loteId.size() <= 64 &&
        e.loteNombre is string && e.loteNombre.size() <= 80 &&
        e.mensajeId is string && e.mensajeId.size() > 0 && e.mensajeId.size() <= 200 &&
        e.creadoEn is timestamp &&
        e.huella is string && e.huella.size() == 64;
    }

    // Alfonsito solo llena un día vacío o reemplaza una entrada suya que nadie corrigió.
    function alfonsitoPuedeTocar(dia) {
      return resource == null || !(dia in resource.data) ||
        (resource.data[dia].get('origen', '') == 'alfonsito' &&
         resource.data[dia].get('editadoPorPersona', false) == false);
    }

    function escrituraDeAlfonsito(fincaId, weekId) {
      return esEscritor(fincaId) &&
        exists(/databases/$(database)/documents/fincas/$(fincaId)/semanas/$(weekId)) &&
        cambiaUnSoloDia() &&
        elDia() in request.resource.data &&
        entradaAlfonsito(request.resource.data[elDia()]) &&
        alfonsitoPuedeTocar(elDia());
    }

    // Entrada que escribe una persona desde el Libro: siempre con la marca.
    function entradaPersona(e) {
      return e is map &&
        e.get('origen', '') == 'persona' &&
        e.get('editadoPorPersona', false) == true &&
        e.get('loteId', null) is string && e.loteId.size() <= 64 &&
        e.get('loteNombre', '') is string;
    }

    function escrituraDePersona(fincaId) {
      return request.auth != null &&
        (request.auth.uid == fincaId || esMayordomo(fincaId)) &&
        cambiaUnSoloDia() &&
        elDia() in request.resource.data &&
        entradaPersona(request.resource.data[elDia()]);
    }

    match /mayordomos/{muid} {
      allow read: if request.auth != null && request.auth.uid == muid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fincaId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.fincaId;
    }

    match /fincas/{fincaId} {
      allow read: if request.auth != null &&
        (request.auth.uid == fincaId ||
         request.auth.uid == resource.data.mayordomoUid ||
         request.auth.uid == resource.data.get('lectorUid', ''));
      allow create, update: if request.auth != null && request.auth.uid == fincaId;

      match /semanas/{weekId} {
        allow read: if request.auth != null &&
          (request.auth.uid == fincaId ||
           request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.mayordomoUid ||
           esLector(fincaId));

        allow create, update: if request.auth != null && (
          request.auth.uid == fincaId
          ||
          (
            request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.mayordomoUid
            &&
            request.resource.data.precioKg ==
              (resource != null ? resource.data.precioKg : get(/databases/$(database)/documents/fincas/$(fincaId)).data.precioKg)
            &&
            request.resource.data.pagada == (resource != null ? resource.data.pagada : false)
          )
        );
      }

      // Secciones privadas del dueño: insumos, pago del mayordomo, pergamino y resumen.
      // El lector las lee (los informes van solo al dueño); nunca escribe.
      match /privado/{docId} {
        allow read: if request.auth != null && (request.auth.uid == fincaId || esLector(fincaId));
        allow write: if request.auth != null && request.auth.uid == fincaId;
      }

      // Jornales y contratos: los usan el dueño y el mayordomo; el mayordomo no puede cambiar los pagos
      match /jornales/{weekId} {
        allow read: if request.auth != null &&
          (request.auth.uid == fincaId ||
           request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.mayordomoUid ||
           esLector(fincaId));
        allow create, update: if request.auth != null && (
          request.auth.uid == fincaId
          ||
          (
            request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.mayordomoUid
            &&
            request.resource.data.get('pagosJornales', {}) ==
              (resource != null ? resource.data.get('pagosJornales', {}) : {})
          )
        );
      }

      // Lote cogido por día (D-104). Lo leen el dueño, el mayordomo, el lector y el escritor.
      // Escriben Alfonsito (con escritorUid) y las personas, cada uno con sus reglas; solo el dueño borra.
      match /lotesCogida/{weekId} {
        allow read: if request.auth != null &&
          (request.auth.uid == fincaId || esMayordomo(fincaId) || esLector(fincaId) || esEscritor(fincaId));
        allow create, update: if escrituraDeAlfonsito(fincaId, weekId) || escrituraDePersona(fincaId);
        allow delete: if request.auth != null && request.auth.uid == fincaId;
      }

      // Lotes, trabajadores y valor del jornal: los lee el mayordomo (y el lector); solo el dueño los cambia
      match /compartido/{docId} {
        allow read: if request.auth != null &&
          (request.auth.uid == fincaId ||
           request.auth.uid == get(/databases/$(database)/documents/fincas/$(fincaId)).data.mayordomoUid ||
           esLector(fincaId));
        allow write: if request.auth != null && request.auth.uid == fincaId;
      }
    }
  }
}
